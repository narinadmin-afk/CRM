# ===== ข้อมูลเชื่อมต่อฐานข้อมูล MySQL =====
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องของคุณ
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=crm_customers
DB_PORT=3306

# ===== พอร์ตของเซิร์ฟเวอร์ API =====
PORT=5000

# ===== ที่อยู่ Frontend ที่อนุญาตให้เรียก API (CORS) =====
# เว้นว่าง = อนุญาตทุกแหล่งที่มา (เหมาะตอนพัฒนา)
CLIENT_ORIGIN=
